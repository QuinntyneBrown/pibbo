{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Content": ""
  },
  "Content": {
    "Root": "content"
  },
  "Transport": {
    "RequireHttps": true,
    "HttpsPort": 443
  },
  "Cors": {
    "FrontendOrigin": ""
  },
  "RateLimit": {
    "RequestsPerMinute": 300
  }
}
