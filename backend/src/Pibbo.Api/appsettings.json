{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "TimestampFormat": "O",
        "UseUtcTimestamp": true,
        "IncludeScopes": false
      }
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "AddServerHeader": false
  },
  "Content": {
    "Root": "content"
  },
  "Transport": {
    "RequireHttps": true,
    "HttpsPort": 443
  },
  "Cors": {
    "FrontendOrigin": ""
  },
  "RateLimit": {
    "RequestsPerMinute": 300
  }
}
