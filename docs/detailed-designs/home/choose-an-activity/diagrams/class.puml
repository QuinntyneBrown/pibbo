@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Choose an activity from Home

enum GroupId {
  read
  count
}
class Activity {
  +id: string
  +group: GroupId
  +section: string
  +name: string
  +glyph: string
  +recording: string
  +path: string
}
class ActivityCatalogue {
  +groups: ActivityGroup[]
  +activities: Activity[]
}
class ActivityGroup {
  +id: GroupId
  +name: string
  +recording: string
}
interface ChildProfile {
  +name: string
  +stars: Record<string, number>
}
class Home {
  -chosen: Signal<ActivityGroup>
  -sections: Signal<ActivitySection[]>
  -lessonDone: Signal<number>
  +chooseGroup(g: ActivityGroup): void
  +openActivity(a: Activity): void
  +openLesson(l: Lesson): void
  +openCheckGame(): void
}
ActivityCatalogue "1" *-- "*" Activity
ActivityCatalogue "1" *-- "2" ActivityGroup
Home ..> ActivityCatalogue : reads
Home ..> ChildProfile : CHILD_PROFILE (SAMPLE_CHILD)
Home ..> ProgressStore : lesson place
@enduml
