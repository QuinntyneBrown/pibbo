@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Silent-e words

interface AudioPlayer <<token AUDIO_PLAYER>> {
  +play(recordingId: string): Promise<PlayOutcome>
  +stop(): void
}
interface RandomSource <<token RANDOM_SOURCE>> {
  +next(): number
}
interface RoundFeedback <<token ROUND_FEEDBACK>> {
  +praise(): void
  +hint(h: Hint): void
}

class SilentEPair {
  +short: Word
  +long: Word
}
class SilentERound {
  +pair: SilentEPair
  +withE: boolean
}
class silentERules <<pure>> {
  +toggle(r: SilentERound): SilentERound
  +judgePicture(r: SilentERound, pictureId: string): Answer
}
SilentERound --> SilentEPair
@enduml
