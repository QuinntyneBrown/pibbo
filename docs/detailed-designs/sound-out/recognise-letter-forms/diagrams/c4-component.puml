@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Recognise uppercase and lowercase
Container_Boundary(b, "pibbo (Angular workspace)") {
  Component(page, "LetterFormsPage", "Angular route component", "Orchestrates the round")
  Component(view, "LetterPairComponent", "Presentation component", "Renders targets, emits touches")
  Component(rules, "formRules", "Pure domain functions", "Builds rounds, judges touches")
  Component(fb, "RoundFeedback", "Domain service", "Praise, hint, model answer")
  Component(audio, "AudioPlayer", "Token AUDIO_PLAYER", "One recording at a time")
  Component(rnd, "RandomSource", "Token RANDOM_SOURCE", "Injected randomness")
}
Rel(page, view, "Binds state; listens to touched")
Rel(page, rules, "Calls")
