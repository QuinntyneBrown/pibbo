@startuml
title UML sequence behaviour — Find the rhyming word
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Child" as actor
box "Frontend — pibbo application" #E0F2FE
  participant "RhymeTime" as page
end box
box "Frontend — @pibbo/components library" #E0F2FE
  participant "RhymeCards" as view
end box
box "Frontend — @pibbo/domain library" #ECFDF3
  participant "rhyme rules" as rules
end box
box "Frontend — browser services (audio, storage)" #FFF4E5
  participant "AudioPlayer" as audio
end box
page -> audio : the instruction [L2-021 #1]
loop each card touched
  actor -> view : Touch a card
  view --> page : touched(i)
  page -> rules : toggleRhyme(round, i)
  page -> audio : target, then the card's word [L2-021 #2]
end
actor -> view : Touch Check
page -> rules : checkRhymes(round)
alt exactly the rhymes
  page -> audio : praise [L2-021 #4]
else first or second miss
  page -> audio : hint, with Try again [L2-021 #5]
else third miss
  page -> audio : the modelled rhymes [L2-021 #6]
end
@enduml
