@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Hear rhymes

interface AudioPlayer <<token AUDIO_PLAYER>> {
  +play(recordingId: string): Promise<PlayOutcome>
  +stop(): void
}
interface RandomSource <<token RANDOM_SOURCE>> {
  +next(): number
}
interface Clock <<token CLOCK>> {
  +after(ms: number, run: () => void): () => void
}

class RhymeTime
class RhymeCards <<pb-rhyme-cards>>
class RhymeRound {
  +phase: choosing | retry | right | modelled
  +set: RhymeSet
  +cards: RhymeWord[]
  +chosen: number[]
  +wrong: number
}
class "rhyme rules" as rules <<pure>> {
  +startRhymeRound(random, sets, previous): RhymeRound
  +toggleRhyme(r, i): RhymeTouch
  +checkRhymes(r): RhymeRound
  +chooseRhymesAgain(r): RhymeRound
}
RhymeRound "1" *-- "2..4" RhymeWord
RhymeTime --> RhymeCards
RhymeTime --> rules
RhymeTime --> RhymeRound
RhymeTime --> AudioPlayer
RhymeTime --> Clock
rules --> RandomSource
@enduml
