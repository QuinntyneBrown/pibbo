@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Recognise common words

interface AudioPlayer <<token AUDIO_PLAYER>> {
  +play(url: string): Promise<PlayOutcome>
  +stop(): void
}
interface RandomSource <<token RANDOM_SOURCE>> {
  +next(): number
}
class CommonWord {
  +word: string
  +recording: string
}
class SpotRound {
  +phase: 'finding' | 'right'
  +word: CommonWord
  +story: string[]
  +found: boolean[]
  +miss: number | null
  +missed: boolean
}
class "Spot rules" as rules <<pure>> {
  +startSpotRound(word, story): SpotRound
  +touchStoryWord(round, index): SpotTouch
  +endMiss(round): SpotRound
  +nextSpotWord(rnd, words, due, previous): CommonWord
  +spotAssets(round): string[]
}
class SpotTheWordPage {
  -round: Signal<SpotRound>
  -due: string[]  // route scope, never stored
}
SpotRound --> CommonWord
rules ..> SpotRound
rules ..> RandomSource
SpotTheWordPage ..> rules
SpotTheWordPage ..> AudioPlayer
@enduml
