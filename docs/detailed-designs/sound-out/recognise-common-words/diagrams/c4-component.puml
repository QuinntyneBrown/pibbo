@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Recognise common words
Container_Boundary(b, "pibbo (Angular workspace)") {
  Component(page, "SpotTheWordPage", "Angular route component", "Orchestrates the round and the missed words")
  Component(view, "SpotTheWord (pb-spot)", "Presentation component", "Renders the story, emits touches")
  Component(rules, "Spot rules", "Pure domain functions", "Builds rounds, judges touches, chooses the next word")
  Component(audio, "AudioPlayer", "Token AUDIO_PLAYER", "One recording at a time")
  Component(rnd, "RandomSource", "Token RANDOM_SOURCE", "Injected randomness")
  Component(clock, "Clock", "Token CLOCK", "Ends a miss and praise")
}
Rel(page, view, "Binds state; listens to word")
Rel(page, rules, "Calls")
Rel(rules, rnd, "Draws from")
Rel(page, audio, "Plays recordings")
Rel(page, clock, "Times the miss and praise")
@enduml
