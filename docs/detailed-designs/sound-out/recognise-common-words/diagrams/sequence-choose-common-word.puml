@startuml
title UML sequence behaviour — Find a common word
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Child" as actor
box "Frontend — pibbo application" #E0F2FE
  participant "SpotTheWordPage" as page
end box
box "Frontend — @pibbo/components library" #E0F2FE
  participant "SpotTheWord" as view
end box
box "Frontend — @pibbo/domain library" #ECFDF3
  participant "Spot rules" as rules
end box
box "Frontend — browser services" #FFF4E5
  participant "AudioPlayer" as audio
end box
page -> rules : nextSpotWord(rnd, words, due, previous)
page -> audio : "Find every", word, "in the story." [L2-019 #1]
actor -> view : Touch a word
view -> page : word(index)
page -> rules : touchStoryWord(round, index)
alt the common word
  page -> audio : play word; highlight, one more dot [L2-019 #2]
  opt every one found
    page -> audio : "You found", word, number, "times" [L2-019 #4]
  end
else another word
  page -> page : grey 0.4 s, no sound; word joins due [L2-019 #3, #5]
end
note over page : due lives at route scope; nothing is stored or sent [L2-019 #6]
@enduml
