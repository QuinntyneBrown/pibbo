@startuml
title UML sequence behaviour — Fill the slots by sound
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Child" as actor
box "Frontend — pibbo application" #E0F2FE
  participant "SpellPage" as page
end box
box "Frontend — @pibbo/components library" #E0F2FE
  participant "SpellSlotsComponent" as view
end box
box "Frontend — @pibbo/domain library" #ECFDF3
  participant "spellRules" as rules
end box
box "Frontend — browser services (audio, storage)" #FFF4E5
  participant "AudioPlayer" as audio
end box
page -> audio : play("word-sun")
actor -> view : Touch letter tile
page -> rules : choose(round, letter)
alt filled
  page -> audio : play letter sound [L2-013 #1]
else retry
  page -> audio : play wrong sound, then "sound-u" [L2-013 #2]
end
opt complete
  page -> audio : play("word-sun")
end
actor -> view : Touch a filled slot
page -> audio : play its sound; letter stays [L2-013 #3]
@enduml
