@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Build a short sentence

interface AudioPlayer <<token AUDIO_PLAYER>> {
  +play(recordingId: string): Promise<PlayOutcome>
  +stop(): void
}
interface RandomSource <<token RANDOM_SOURCE>> {
  +next(): number
}
interface Clock <<token CLOCK>> {
  +after(ms: number, run: () => void): () => void
}
interface ActivityExit <<token ACTIVITY_EXIT>> {
  +leave(group): void
  +finish(group): void
}

class BuildASentence
class SentenceBuilder <<pb-sentence-builder>>
class SentenceRound {
  +phase: building | retry | right | modelled
  +sentence: Sentence
  +tiles: SentenceWord[]
  +placed: number[]
  +wrong: number
}
class "sentence rules" as rules <<pure>> {
  +startSentenceRound(random, sentences, previous): SentenceRound
  +placeWord(r, i): SentenceTouch
  +takeBackWord(r, position): SentenceRound
  +canCheckSentence(r): boolean
  +checkSentence(r): SentenceRound
  +buildSentenceAgain(r): SentenceRound
}
SentenceRound "1" *-- "4..6" SentenceWord
BuildASentence --> SentenceBuilder
BuildASentence --> rules
BuildASentence --> SentenceRound
BuildASentence --> AudioPlayer
BuildASentence --> Clock
BuildASentence --> ActivityExit
rules --> RandomSource
@enduml
