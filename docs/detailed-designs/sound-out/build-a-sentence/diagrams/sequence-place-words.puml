@startuml
title UML sequence behaviour — Build the sentence and check it
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Child" as actor
box "Frontend — pibbo application" #E0F2FE
  participant "BuildASentence" as page
end box
box "Frontend — @pibbo/components library" #E0F2FE
  participant "SentenceBuilder" as view
end box
box "Frontend — @pibbo/domain library" #ECFDF3
  participant "sentence rules" as rules
end box
box "Frontend — browser services (audio, storage)" #FFF4E5
  participant "AudioPlayer" as audio
end box
actor -> view : Touch word tile
view -> page : tile(i)
page -> rules : placeWord(round, i)
page -> audio : play word [L2-020 #2]
page --> view : word at the end of the strip; tile used [L2-020 #2]
opt touch a word on the strip
  page -> rules : takeBackWord(round, position) [L2-020 #3]
end
actor -> page : Check, once the strip is full [L2-020 #4]
page -> rules : checkSentence(round)
alt in order
  page -> audio : play sentence; show praise [L2-020 #5]
else third miss
  page -> audio : play "Listen:", sentence; show it in order [L2-020 #7]
else miss
  page -> audio : play hint; Try again empties the strip [L2-020 #6]
end
@enduml
