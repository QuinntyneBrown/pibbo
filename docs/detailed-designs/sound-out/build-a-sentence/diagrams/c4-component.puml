@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Build a short sentence
Container_Boundary(b, "pibbo (Angular workspace)") {
  Component(page, "BuildASentence", "Angular route component", "Orchestrates the round")
  Component(view, "SentenceBuilder", "Presentation component", "Picture, strip and word bank; emits touches")
  Component(rules, "sentence rules", "Pure domain functions", "Builds rounds, judges touches and Check")
  Component(content, "SENTENCES", "Domain data", "Sentences, words, pictures and recordings")
  Component(audio, "AudioPlayer", "Token AUDIO_PLAYER", "One recording at a time")
  Component(rnd, "RandomSource", "Token RANDOM_SOURCE", "Injected randomness")
  Component(exit, "ActivityExit", "Token ACTIVITY_EXIT", "Home, or back to the lesson's path")
}
Rel(page, view, "Binds state; listens to touches")
Rel(page, rules, "Calls")
Rel(page, content, "Reads")
Rel(rules, rnd, "Draws from")
Rel(page, audio, "Plays recordings")
