@startuml
title UML sequence behaviour — Pair a word with its picture
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Child" as actor
box "Frontend — pibbo application" #E0F2FE
  participant "WordsAndPictures" as page
end box
box "Frontend — @pibbo/components library" #E0F2FE
  participant "WordPictures" as view
end box
box "Frontend — @pibbo/domain library" #ECFDF3
  participant "word-pictures-round" as rules
end box
box "Frontend — browser services" #FFF4E5
  participant "AudioPlayer" as audio
end box
actor -> view : touch a word [L2-018 #2, #4]
view -> page : word(i)
page -> rules : holdWord(round, i)
rules --> page : held; its sounds
page -> audio : play each sound in turn ("b", "oa", "t")
actor -> view : touch a picture [L2-018 #4]
view -> page : picture(j)
page -> rules : matchPicture(round, j)
alt its picture
  rules --> page : matched; the word
  page -> audio : play the word [L2-018 #1]
else another picture
  rules --> page : miss; the word, then the picture's word; word let go
  page -> view : missed = j (shake, none with reduced motion)
  page -> audio : play the word, then the picture's word [L2-018 #1]
end
opt every pair joined
  page -> audio : praise naming the theme [L2-018 #3]
  page -> view : Next offered
end
@enduml
