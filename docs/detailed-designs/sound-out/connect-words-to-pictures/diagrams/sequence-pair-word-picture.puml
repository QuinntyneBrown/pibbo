@startuml
title UML sequence behaviour — Pair a word with its picture
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Child" as actor
box "Frontend — pibbo application" #E0F2FE
  participant "WordPicturePage" as page
end box
box "Frontend — @pibbo/components library" #E0F2FE
  participant "PairingBoardComponent" as view
end box
box "Frontend — @pibbo/domain library" #ECFDF3
  participant "pairingRules" as rules
end box
box "Frontend — browser services (audio, storage)" #FFF4E5
  participant "AudioPlayer" as audio
end box
actor -> view : Touch word, then picture [L2-018 #4]
page -> rules : selectPicture(round, p)
alt match
  page -> audio : play word [L2-018 #1]
else no match
  page -> audio : play word, then picture word
end
opt all joined
  page -> audio : praise; play theme [L2-018 #3]
end
@enduml
