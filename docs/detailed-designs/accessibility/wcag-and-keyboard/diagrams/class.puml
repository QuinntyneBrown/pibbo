@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — WCAG 2.2 AA and keyboard

interface Target {
  +accessibleName: string
  +state: "idle" | "counted" | "correct" | "current"
}
class RovingFocus {
  +manager: FocusKeyManager<Target>
  +onKeydown(e: KeyboardEvent): void
}
RovingFocus --> Target
@enduml
