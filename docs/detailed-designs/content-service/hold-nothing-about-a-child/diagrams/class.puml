@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Hold nothing about a child

class ReadOnlyPublicPolicy {
  +Apply(endpoints: EndpointRouteBuilder): void
}
class PrivacyLogEnricher {
  +Enrich(e: LogEvent): void
  -TruncateIp(ip: IPAddress): string
}
class NoCookieMiddleware {
  +InvokeAsync(ctx: HttpContext): Task
}
@enduml
