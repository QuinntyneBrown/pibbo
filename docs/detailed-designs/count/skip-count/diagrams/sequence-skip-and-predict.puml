@startuml
title UML sequence behaviour — Count in groups and predict the next number
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Child" as actor
box "Frontend — pibbo application" #E0F2FE
  participant "SkipCountPage" as page
end box
box "Frontend — @pibbo/components library" #E0F2FE
  participant "GroupedSetComponent" as view
end box
box "Frontend — @pibbo/domain library" #ECFDF3
  participant "skipRules" as rules
end box
box "Frontend — browser services (audio, storage)" #FFF4E5
  participant "AudioPlayer" as audio
end box
actor -> view : Touch a group
page -> rules : touchGroup(round)
rules --> page : reached + step [L2-007 #1-3]
page -> audio : play running total
actor -> view : Choose what comes next
page -> rules : judgeNext(round, n)
alt wrong (e.g. 11 after 5, 10)
  page --> view : show next group of 5
  page -> audio : count on 11..15 aloud [L2-007 #4]
end
@enduml
