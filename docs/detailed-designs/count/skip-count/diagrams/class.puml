@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Skip-count by twos, fives and tens

interface AudioPlayer <<token AUDIO_PLAYER>> {
  +play(recordingId: string): Promise<PlayOutcome>
  +stop(): void
}
interface RandomSource <<token RANDOM_SOURCE>> {
  +next(): number
}
interface RoundFeedback <<token ROUND_FEEDBACK>> {
  +praise(): void
  +hint(h: Hint): void
}

class SkipRound {
  +step: 2 | 5 | 10
  +reached: number
  +limit(): number
}
class skipRules <<pure>> {
  +sequence(step): number[]
  +touchGroup(r: SkipRound): SkipRound
  +judgeNext(r: SkipRound, n: number): Answer
}
skipRules ..> SkipRound
@enduml
