@startuml
title UML sequence behaviour — Write the numeral with digit tiles
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Child" as actor
box "Frontend — pibbo application" #E0F2FE
  participant "CountAndWrite" as page
end box
box "Frontend — @pibbo/components library" #E0F2FE
  participant "DigitPad" as pad
end box
box "Frontend — @pibbo/domain library" #ECFDF3
  participant "round rules" as rules
end box
box "Frontend — browser services" #FFF4E5
  participant "AudioPlayer" as audio
end box
page -> rules : startCountAndWriteRound(random, content)
rules --> page : 14 things in one full and one partial ten-frame [L2-003 #1]
== child counts to 14 ==
page -> audio : play(numbers/14) then play(write-how-many) [L2-003 #2]
actor -> pad : Touch 1
page -> rules : writeDigit(round, 1)
page -> audio : play(numbers/1) [L2-004 #5]
actor -> pad : Touch 4
page -> rules : writeDigit(round, 4)
actor -> pad : Touch a third digit
rules --> page : ignored [L2-004 #4]
actor -> page : Check
page -> rules : checkNumeral(round)
alt written 14
  rules --> page : right
  page -> audio : play(numbers/14), praise [L2-004 #1]
else written 41
  rules --> page : hinting; boxes cleared
  page -> pad : light 1, play(numbers/1); light 4, play(numbers/4) [L2-004 #2]
  page -> rules : hintDone(round)
end
@enduml
