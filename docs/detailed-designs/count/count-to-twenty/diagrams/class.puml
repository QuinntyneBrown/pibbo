@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Count to twenty and write the numeral

interface AudioPlayer <<token AUDIO_PLAYER>> {
  +play(recording: string): Promise<PlayOutcome>
  +stop(): void
}
interface RandomSource <<token RANDOM_SOURCE>> {
  +next(): number
}
interface Clock <<token CLOCK>> {
  +after(ms: number, callback): () => void
}

class CountAndWriteRound {
  +phase: "counting" | "writing" | "hinting" | "right" | "modelled"
  +answer: number
  +things: Thing[]
  +countedAs: (number | null)[]
  +written: number[]
  +wrong: number
}
class roundRules <<pure>> {
  +startCountAndWriteRound(random, content): CountAndWriteRound
  +tenFrames(n: number): number[][]
  +countThing(r, index): TouchResult
  +writeDigit(r, digit): TouchResult
  +clearDigits(r): CountAndWriteRound
  +checkNumeral(r): CheckResult
  +hintDone(r): CountAndWriteRound
}
class CountAndWrite <<page>>
class Tenframes <<pb-tenframes>>
class DigitPad <<pb-digit-pad>>
roundRules ..> CountAndWriteRound
CountAndWrite ..> roundRules
CountAndWrite ..> AudioPlayer
CountAndWrite ..> RandomSource
CountAndWrite ..> Clock
CountAndWrite --> Tenframes
CountAndWrite --> DigitPad
@enduml
