@startuml
title UML sequence behaviour — Advance, pause and resume a lesson
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Child" as actor
box "Frontend — pibbo application" #E0F2FE
  participant "LessonPage" as page
end box
box "Frontend — @pibbo/components library" #E0F2FE
  participant "LessonPathComponent" as path
end box
box "Frontend — @pibbo/domain library" #ECFDF3
  participant "lessonRules" as rules
end box
box "Frontend — browser services (audio, storage)" #FFF4E5
  participant "ProgressStore" as store
end box
page -> rules : lessonSteps(lesson, catalogue)
alt a step names an unknown activity
  page -> page : ClientLog.warn(lesson and activity ids only) [L2-022 #4]
end
page -> store : read("pibbo:lesson:count")
page -> rules : readLessonPlace(stored, steps) [L2-022 #2]
page --> path : current step by shape and colour; "Up next" spoken and shown
actor -> page : Touch Play
page -> page : open activity ?lesson=count&step=1
actor -> page : Finish activity 1, touch Next
page -> rules : finishStep(1, finished 1, steps)
page -> store : write {v:1, step:2, at}
page --> path : step 2 current [L2-022 #1]
actor -> page : Touch Home
page -> page : navigate to Home, no confirmation [L2-022 #3]
@enduml
