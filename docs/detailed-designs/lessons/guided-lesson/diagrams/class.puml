@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Follow a guided lesson

class Lesson {
  +id: "count" | "read"
  +kicker: string
  +title: string
  +activities: string[3..6]
}
class LessonStep {
  +number: number
  +activity: Activity
}
class LessonPlace <<device-only>> {
  +v: 1
  +step: number
  +at: string | "done"
}
class lessonRules <<pure>> {
  +lessonSteps(l: Lesson, catalogue): {steps, unknown}
  +readLessonPlace(stored: unknown, steps): number | null
  +lessonPlace(step, steps): LessonPlace
  +finishStep(current, finished, steps): number
}
interface ProgressStore {
  +read(key): unknown
  +write(key, value): void
  +clearAll(): void
}
interface ActivityExit {
  +leave(group): void
  +finish(group): void
}
interface ClientLog {
  +warn(message): void
}
Lesson "1" --> "3..6" LessonStep
lessonRules ..> LessonPlace
lessonRules ..> LessonStep
ProgressStore ..> LessonPlace
@enduml
