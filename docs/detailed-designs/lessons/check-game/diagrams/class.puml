@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Play the check game

class CheckPlan {
  +rounds: RoundRef[]
}
class CheckResult {
  +earnedSkills: string[]
}
class checkRules <<pure>> {
  +plan(history: unknown, firstLesson: Lesson, rnd): CheckPlan
  +earned(answers: Answer[]): CheckResult
}
checkRules ..> CheckPlan
checkRules ..> CheckResult
@enduml
