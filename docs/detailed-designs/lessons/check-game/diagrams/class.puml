@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Play the check game

class CheckQuestion {
  +activity: string
  +group: count | read
  +show: CheckShow
  +choices: CheckChoice[]
  +answer: string
}
class CheckRound {
  +phase: choosing | retry | right | modelled
  +chosen: string | null
  +wrong: number
}
class CheckResults {
  +title: string
  +sections: CheckResultSection[]
  +spoken: string[]
}
class StoredActivities {
  +version: 1
  +activities: string[]
}
class checkRules <<pure>> {
  +planCheck(rnd, content, practised, askable): string[]
  +makeQuestion(rnd, activity): CheckQuestion
  +checkQuestionRound(round, question): CheckRound
  +checkResults(right, activities, content): CheckResults
}
class progressRules <<pure>> {
  +readActivities(value: unknown): string[]
  +addActivities(have, more): StoredActivities
}
interface ProgressStore {
  +read(key): unknown
  +write(key, value)
  +clearAll()
}
checkRules ..> CheckQuestion
checkRules ..> CheckRound
checkRules ..> CheckResults
CheckRound o--> CheckQuestion
progressRules ..> StoredActivities
ProgressStore ..> StoredActivities
@enduml
