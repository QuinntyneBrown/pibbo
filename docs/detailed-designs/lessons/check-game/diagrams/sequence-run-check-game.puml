@startuml
title UML sequence behaviour — Run the check game
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Child" as actor
box "Frontend — pibbo application" #E0F2FE
  participant "CheckGame" as page
end box
box "Frontend — @pibbo/components library" #E0F2FE
  participant "EarnedPictures" as res
end box
box "Frontend — @pibbo/domain library" #ECFDF3
  participant "checkRules" as rules
end box
box "Frontend — browser services (audio, storage)" #FFF4E5
  participant "ProgressStore" as store
end box
page -> store : read("practised", readActivities) [L2-023 #4]
page -> rules : planCheck(rnd, practised, content) [L2-023 #5]
loop 5-8 questions
  actor -> page : Choose and Check (retry rule on wrong) [L2-023 #2]
end
page -> rules : earnedActivities(rounds)
page --> res : earned pictures only [L2-023 #1]
page -> store : write("earned", ids) [L2-023 #3]
@enduml
