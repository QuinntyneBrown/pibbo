@startuml
title UML sequence behaviour — Play offline and update later
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Child" as actor
box "Frontend — pibbo application" #E0F2FE
  participant "HomePage" as home
end box
box "Frontend — browser services (audio, storage)" #FFF4E5
  participant "ActivityAvailability" as av
  participant "Service worker" as sw
end box
home -> av : isAvailable(each)
av -> sw : cache match
alt offline and uncached
  home --> actor : greyed picture + no-network symbol; does not open [L2-033 #2]
else cached
  home --> actor : opens and plays fully [L2-033 #1]
end
sw -> sw : new version downloaded in background
sw --> home : activate between rounds [L2-033 #3]
@enduml
