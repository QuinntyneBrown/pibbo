{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve pibbo",
    "build": "node ../tools/content/check-content.mjs && ng build pibbo && node ../tools/service-worker/write-service-worker.mjs",
    "build:libs": "ng build api && ng build domain && ng build components",
    "lint": "ng lint && eslint e2e playwright.config.ts playwright.sweeps.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node ../tools/verify/unit-tests.mjs",
    "e2e": "playwright test",
    "sweep": "playwright test -c playwright.sweeps.config.ts",
    "sweep:a11y": "playwright test -c playwright.sweeps.config.ts accessibility",
    "sweep:heap": "playwright test -c playwright.sweeps.config.ts heap",
    "sweep:visual": "playwright test -c playwright.sweeps.config.ts visual",
    "sweep:load": "playwright test -c playwright.sweeps.config.ts load"
  },
  "private": true,
  "packageManager": "npm@11.16.0",
  "dependencies": {
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/router": "^22.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@axe-core/playwright": "^4.14.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.11",
    "angular-eslint": "22.8.0",
    "eslint": "^10.14.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.72.2",
    "vitest": "^5.0.0"
  }
}
